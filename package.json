{
  "name": "apigate",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic API Gateway & Rate Limiter",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/gateway",
    "packages/adapters/*"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc --build && node packages/core/scripts/copy-lua.mjs && node packages/gateway/scripts/copy-assets.mjs",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
