{
  "name": "@apigate/core",
  "version": "0.1.0",
  "description": "Framework-agnostic rate limiting, auth, caching and circuit breaking primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ratelimit": {
      "types": "./dist/ratelimit/index.d.ts",
      "default": "./dist/ratelimit/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./breaker": {
      "types": "./dist/breaker/index.d.ts",
      "default": "./dist/breaker/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc --build && node scripts/copy-lua.mjs",
    "clean": "tsc --build --clean",
    "compare-algorithms": "tsx scripts/compare-algorithms.ts"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "ioredis": "^6.0.0"
  },
  "peerDependencies": {
    "ioredis": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  }
}
